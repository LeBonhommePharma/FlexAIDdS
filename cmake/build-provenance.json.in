{
  "schema": "flexaidds-build-provenance/1",
  "package_version": "@FLEXAIDS_VERSION_STR@",
  "git_commit": "@FLEXAIDS_GIT_COMMIT@",
  "git_dirty": "@FLEXAIDS_GIT_DIRTY@",
  "git_dirty_meaning": "0=clean 1=dirty 2=unknown (never assume clean)",
  "source_provenance": "@FLEXAIDS_SRC_PROVENANCE@",
  "configured_utc": "@FLEXAIDS_BUILT_UTC@",
  "cmake_version": "@CMAKE_VERSION@",
  "build_type": "@CMAKE_BUILD_TYPE@",
  "cxx_compiler_id": "@CMAKE_CXX_COMPILER_ID@",
  "cxx_compiler_version": "@CMAKE_CXX_COMPILER_VERSION@",
  "cxx_standard": "@CMAKE_CXX_STANDARD@",
  "system_name": "@CMAKE_SYSTEM_NAME@",
  "system_processor": "@CMAKE_SYSTEM_PROCESSOR@",
  "eigen_version": "@FLEXAIDS_EIGEN_VERSION_DETECTED@",
  "eigen_version_declared": "@FLEXAIDS_EIGEN_VERSION@",
  "eigen_macro_triple": "@FLEXAIDS_EIGEN_MACRO_TRIPLE@",
  "eigen_source": "@FLEXAIDS_EIGEN_SOURCE@",
  "eigen_version_meaning": "eigen_version is READ BACK from the headers compiled against; eigen_version_declared is what cmake/FlexAIDEigen.cmake pins. They are equal unless FLEXAIDS_ALLOW_EIGEN_MISMATCH was used. eigen_macro_triple is the literal EIGEN_WORLD_VERSION.EIGEN_MAJOR_VERSION.EIGEN_MINOR_VERSION and is NOT the release number above Eigen 5: WORLD is frozen at 3, so a 5.x release reports a 3.x triple that matches no release. Compare eigen_version, not eigen_macro_triple."
}
