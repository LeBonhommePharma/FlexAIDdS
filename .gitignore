# One-off / temp campaign, monitor, failsafe, and launch scripts.
# Prevents untracked files from blocking `git pull` / `git merge` (see AGENTS.md and prior merge conflicts with m3pro/failsafe_campaign.py etc.).
# These ignores must follow the !benchmarks / !scripts allow entries.
benchmarks/**/*failsafe*.py
benchmarks/**/*campaign*.py
benchmarks/m3pro/*.py
benchmarks/**/monitor*.sh
benchmarks/**/launch*.sh
scripts/**/*campaign*.sh
scripts/**/*monitor*.sh
scripts/**/*launch*.sh
scripts/**/*failsafe*.sh
# code coverage artifacts
*.gcda
*.gcno
*.gcov
build/coverage
lcov.info
# build directories (CMake artifacts)
WRK/
build/
build_check/
build_opencode/
.claude/worktrees/

